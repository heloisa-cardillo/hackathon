  const container = document.getElementById('lista-insights-dash');

  container.innerHTML = `
    <div class="card-dashboard">
      <p>Nenhuma resposta registrada ainda.</p>
    </div>
  `;
} -->

<!-- Modal de Execução Interna com o Agente por Tipo -->
<div class="modal-overlay" id="modal-simulacao">
  <div class="modal">
    <button class="modal-close" onclick="fecharModalSimulacao()">&times;</button>
    <h3 id="modal-titulo-pesquisa">Execução da Pesquisa com Agente</h3>
    <div id="modal-corpo-conteudo"></div>
  </div>
</div>

<script>
  let pesquisasCriadas = [
    {
      id: 1,
      tipo: 'qualitative',
      pergunta: 'Dificuldades no uso do Pix',
      urgenciaBase: 'Alta',
      validadeDias: 15,
      dataCriacao: new Date(),
      acesso: 'Checkout',
      respostasTotal: 12,
      doresCount: 4,
      insight: 'Usuários sentem insegurança devido à demora na atualização do comprovante.',
      sentimento: 'Frustração',
      trecho: 'Fiquei sem saber se o pagamento realmente foi concluído.',
      statusDesigner: 'Sugestão da IA',
      temConflito: true
    }
  ];

  function mudarAba(aba) {
    document.querySelectorAll('.view-content').forEach(el => el.classList.remove('visivel'));
    document.querySelectorAll('.main-tabs button').forEach(el => el.classList.remove('ativo'));
    
    if(aba === 'criacao') {
      document.getElementById('view-criacao').classList.add('visivel');
      document.querySelectorAll('.main-tabs button')[0].classList.add('ativo');
    } else if(aba === 'dashboard') {
      document.getElementById('view-dashboard').classList.add('visivel');
      document.querySelectorAll('.main-tabs button')[1].classList.add('ativo');
      renderizarDashboard();
    }
  }

  let tipoAtual = '';
  function prepararTemplate(tipo) {
    tipoAtual = tipo;
    document.getElementById('selecao-cards').style.display = 'none';
    document.getElementById('form-template-container').style.display = 'block';

    const titulos = {
      'qualitative': 'Template: Conversacional',
      'quantitative': 'Template: Múltipla Escolha',
      'discovery': 'Template: Discovery Interview'
    };

    const textosAgente = {
      'qualitative': 'O Agente conduz uma conversa natural e ajuda a estruturar a pergunta-base e o contexto da pesquisa.',
      'quantitative': 'O Agente ajuda a estruturar a pergunta e reformula as alternativas para reduzir vícios de formulação.',
      'discovery': 'O Agente ajuda a transformar o objetivo da pesquisa em um roteiro de entrevista com perguntas abertas e aprofundamentos.'
    };

    document.getElementById('lbl-titulo-template').textContent = titulos[tipo];
    document.getElementById('texto-agente-formulario').textContent = textosAgente[tipo];

    document.querySelectorAll('.modelo-formulario').forEach(el => el.style.display = 'none');
    document.getElementById(`form-${tipo === 'qualitative' ? 'conversacional' : tipo === 'quantitative' ? 'multipla' : 'discovery'}`).style.display = 'block';
    document.getElementById('resposta-agente-formulario').style.display = 'none';
    document.getElementById('input-comando-agente').value = '';
  }

  function acionarAgenteFormulario() {
    const comando = document.getElementById('input-comando-agente').value.trim();
    const resposta = document.getElementById('resposta-agente-formulario');
    if(!comando) return;

    const respostas = {
      qualitative: 'O Agente sugere uma pergunta aberta, sem induzir a resposta, e orienta o contexto para aprofundar a experiência do usuário.',
      quantitative: 'O Agente sugere alternativas claras e equivalentes e pode reformular as palavras-chave para reduzir vieses de formulação.',
      discovery: 'O Agente sugere começar pelo comportamento real do usuário e aprofundar com perguntas abertas, evitando validar a hipótese diretamente.'
    };

    resposta.textContent = respostas[tipoAtual];
    resposta.style.display = 'block';
  }

  function voltarSelecao() {
    document.getElementById('selecao-cards').style.display = 'grid';
    document.getElementById('form-template-container').style.display = 'none';
  }

  function salvarPesquisaTemplate() {
    let pergunta = '';
    if(tipoAtual === 'qualitative') pergunta = document.getElementById('input-pergunta').value.trim();
    if(tipoAtual === 'quantitative') pergunta = document.getElementById('input-pergunta-multipla').value.trim();
    if(tipoAtual === 'discovery') pergunta = document.getElementById('input-pergunta-discovery').value.trim();

    if(!pergunta) {
      alert('Preencha a pergunta-base ou objetivo da pesquisa.');
      return;
    }

    const novaPesquisa = {
      id: Date.now(),
      tipo: tipoAtual,
      pergunta: pergunta,
      urgenciaBase: document.getElementById('select-urgencia-base').value,
      validadeDias: parseInt(document.getElementById('input-validade').value) || 30,
      dataCriacao: new Date(),
      acesso: document.getElementById('input-acesso').value,
      respostasTotal: 1,
      doresCount: 0,
      insight: 'Aguardando interações com o agente...',
      sentimento: 'Neutro',
      trecho: 'Nenhum trecho coletado.',
      statusDesigner: 'Sugestão da IA',
      temConflito: false
    };

    if(tipoAtual === 'qualitative') {
      novaPesquisa.contexto = document.getElementById('input-contexto').value.trim();
    }

    if(tipoAtual === 'quantitative') {
      novaPesquisa.palavrasChave = [
        document.getElementById('kw1').value.trim(),
        document.getElementById('kw2').value.trim(),
        document.getElementById('kw3').value.trim(),
        document.getElementById('kw4').value.trim()
      ];
      if(novaPesquisa.palavrasChave.some(k => !k)) {
        alert('Preencha as 4 alternativas.');
        return;
      }
      novaPesquisa.variarIA = document.getElementById('variar-ia').checked;
    }

    if(tipoAtual === 'discovery') {
      novaPesquisa.perfil = document.getElementById('input-perfil-discovery').value.trim();
      novaPesquisa.contexto = document.getElementById('input-contexto-discovery').value.trim();
    }

    pesquisasCriadas.push(novaPesquisa);
    alert('Formulário gerado com sucesso via Agente de IA!');
    voltarSelecao();
    mudarAba('dashboard');
  }

  function renderizarDashboard() {
    const container = document.getElementById('lista-insights-dash');
    container.innerHTML = '';

    let totalRespostas = pesquisasCriadas.reduce((total, p) => {
      return total + Math.max(0, p.respostasTotal - 1);
    }, 0);

    document.getElementById('contador-insights').textContent =
      `${totalRespostas} Respostas Registradas`;

    pesquisasCriadas.forEach(p => {
      const card = document.createElement('div');
      card.className = 'card-dashboard normal';

      const tipoPesquisa =
        p.tipo === 'qualitative'
          ? 'Conversacional'
          : p.tipo === 'quantitative'
          ? 'Múltipla Escolha'
          : 'Discovery Interview';

      const temResposta = p.trecho && p.trecho !== 'Nenhum trecho coletado.';

      card.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
          <h3>${p.pergunta}</h3>
          <span class="badge-status badge-validado">${tipoPesquisa}</span>
        </div>

        <div class="meta-info">
          <span>📊 Tipo: <strong>${tipoPesquisa}</strong></span>
          <span>👥 Respostas: <strong>${Math.max(0, p.respostasTotal - 1)}</strong></span>
          <span>🔒 Acesso: ${p.acesso}</span>
        </div>

        <p><strong>Resposta registrada:</strong></p>

        <div class="trecho-citacao">
          ${temResposta ? `"${p.trecho}"` : 'Nenhuma resposta registrada ainda.'}
          ${temResposta ? ` (Sentimento: <strong>${p.sentimento}</strong>)` : ''}
        </div>

        <div class="acoes-card">
          <button class="btn-simular-card" onclick="iniciarExecucaoAgente(${p.id})">
            🤖 Responder Formulário
          </button>
        </div>
      `;

      container.appendChild(card);
    });
  }

  // Lógica Interna baseada no tipo de pesquisa acionando o Agente
  function iniciarExecucaoAgente(id) {
    const p = pesquisasCriadas.find(item => item.id === id);
    document.getElementById('modal-titulo-pesquisa').textContent = `Agente IA em Ação — [${p.tipo.toUpperCase()}]`;
    const corpo = document.getElementById('modal-corpo-conteudo');

    if(p.tipo === 'qualitative') {
      // Estilo Qualitativo Conversacional
      corpo.innerHTML = `
        <p class="hint">O Agente conduzirá um diálogo natural adaptando as perguntas ao contexto.</p>
        <div class="chat-box" id="chat-agente">
          <div class="msg ia">Olá! Estou conduzindo esta pesquisa sobre: "<strong>${p.pergunta}</strong>". Como tem sido sua experiência com isso recentemente?</div>
        </div>
        <div class="row-dupla" style="margin-top:10px;">
          <input type="text" id="input-msg-usuario" placeholder="Digite sua resposta...">
          <button class="btn-acao" style="margin-top:0;" onclick="enviarChatQualitativo(${p.id})">Enviar ao Agente</button>
        </div>
      `;
    } else if(p.tipo === 'quantitative') {
      // Estilo Quantitativo com variação de sinônimos por IA
      const sinonimosGerados = ['Lentidão no sistema', 'Demora no processamento', 'Travamento na tela', 'Falha de resposta'];
      corpo.innerHTML = `
        <p class="hint">O Agente reescreveu dinamicamente as alternativas para evitar vícios de formulação:</p>
        <p style="font-weight:600; margin: 10px 0;">${p.pergunta}</p>
        <div class="opcoes-quant">
          ${sinonimosGerados.map(opt => `<button class="btn-opcao-quant" onclick="responderQuantitativo(${p.id}, '${opt}')">${opt}</button>`).join('')}
        </div>
        <div id="status-quant" style="font-size:13px; color:var(--success); margin-top:10px;"></div>
      `;
    } else if(p.tipo === 'discovery') {
      // Estilo Discovery Interview com perguntas abertas e aprofundamento por IA
      corpo.innerHTML = `
        <p class="hint">Entrevista de Descoberta — O Agente conduz o roteiro a partir do objetivo configurado e aprofunda conforme a resposta.</p>
        <div class="chat-box" id="chat-discovery">
          <div class="msg ia"><strong>Agente de IA:</strong> Para investigarmos "${p.pergunta}", conte-me como foi a última vez que você passou por essa situação.</div>
        </div>
        <div class="row-dupla" style="margin-top:10px;">
          <input type="text" id="input-disc-usuario" placeholder="Descreva seu comportamento...">
          <button class="btn-acao" style="margin-top:0;" onclick="enviarDiscovery(${p.id})">Responder</button>
        </div>
      `;
    }

    document.getElementById('modal-simulacao').classList.add('aberto');
  }

  function enviarChatQualitativo(id) {
    const input = document.getElementById('input-msg-usuario');
    const texto = input.value.trim();
    if(!texto) return;

    const chat = document.getElementById('chat-agente');
    chat.innerHTML += `<div class="msg user">${texto}</div>`;
    input.value = '';

    setTimeout(() => {
      chat.innerHTML += `<div class="msg ia">Entendi perfeitamente. O Agente registrou esse ponto como frustração e sintetizou no dashboard.</div>`;
      chat.scrollTop = chat.scrollHeight;
      atualizarDadosPesquisa(id, texto, 'Frustração', true);
    }, 600);
  }

  function responderQuantitativo(id, opcaoEscolhida) {
    document.getElementById('status-quant').textContent = `✔ Resposta registrada pelo Agente: "${opcaoEscolhida}". Dashboard atualizado!`;
    atualizarDadosPesquisa(id, `Escolheu a métrica: ${opcaoEscolhida}`, 'Dúvida', true);
    setTimeout(() => fecharModalSimulacao(), 1500);
  }

  function enviarDiscovery(id) {
    const input = document.getElementById('input-disc-usuario');
    const texto = input.value.trim();
    if(!texto) return;

    const chat = document.getElementById('chat-discovery');
    chat.innerHTML += `<div class="msg user">${texto}</div>`;
    input.value = '';

    setTimeout(() => {
      chat.innerHTML += `<div class="msg ia">Interessante! O Agente aplicou a regra de Nielsen e identificou um padrão comportamental relevante. Síntese concluída.</div>`;
      chat.scrollTop = chat.scrollHeight;
      atualizarDadosPesquisa(id, texto, 'Frustração', true);
    }, 600);
  }

  function atualizarDadosPesquisa(id, trecho, sentimento, temDor) {
    const p = pesquisasCriadas.find(item => item.id === id);
    if(p) {
      p.respostasTotal++;
      if(temDor) p.doresCount++;
      p.trecho = trecho;
      p.sentimento = sentimento;
      p.insight = `Síntese IA atualizada via interação do Agente em ${new Date().toLocaleTimeString()}`;
      renderizarDashboard();
    }
  }

  function fecharModalSimulacao() {
    document.getElementById('modal-simulacao').classList.remove('aberto');
  }

  function aprovarInsight(id) {
    const p = pesquisasCriadas.find(item => item.id === id);
    if(p) {
      p.statusDesigner = 'Validado por Designer';
      p.temConflito = false;
      renderizarDashboard();
    }
  }

  function resolverConflito(id) {
    const p = pesquisasCriadas.find(item => item.id === id);
    if(p) {
      const escolha = confirm('Deseja que este novo insight substitua o anterior?');
      if(escolha) {
        p.temConflito = false;
        p.statusDesigner = 'Validado por Designer (Substituiu anterior)';
      } else {
        p.temConflito = false;
        p.statusDesigner = 'Descartado por Conflito';
      }
      renderizarDashboard();
    }
  }

  window.onload = () => {
    renderizarDashboard();
  };
</script>
</body>
</html>
